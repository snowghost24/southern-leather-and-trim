# Copy to .env.local for local development.
# On Vercel, add these under Project > Settings > Environment Variables.

# Required for the quote form to send email. Create one at https://resend.com
RESEND_API_KEY=

# Optional. Where quote requests are sent. Defaults to the email in lib/site.ts
QUOTE_TO_EMAIL=

# Optional. Needs a domain verified in Resend.
# QUOTE_FROM_EMAIL="Southern Leather and Trim <quotes@yourdomain.com>"

# Set once a custom domain is connected.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
